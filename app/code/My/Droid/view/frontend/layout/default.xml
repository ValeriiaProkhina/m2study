<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="header.container">
            <block class="My\Droid\Block\PromoBar" name="promo.bar" template="My_Droid::promo-bar.phtml" after="-">
                <arguments>
                    <argument name="jsLayout" xsi:type="array">
                        <item name="components" xsi:type="array">
                            <item name="promo-bar-component" xsi:type="array">
                                <item name="component" xsi:type="string">My_Droid/js/view/promo-bar</item>
                                <item name="config" xsi:type="array">
                                    <item name="freeShippingThreshold" xsi:type="number">100</item>
                                </item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>