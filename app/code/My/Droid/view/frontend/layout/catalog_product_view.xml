<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="droid.hello" template="My_Droid::droid.phtml">
                <arguments>
                    <argument name="jsLayout" xsi:type="array">
                        <item name="components" xsi:type="array">
                            <item name="droid-component" xsi:type="array">
                                <item name="component" xsi:type="string">My_Droid/js/droid</item>
                                <item name="config" xsi:type="array">
                                    <item name="droidName" xsi:type="string">BB-8</item>
                                    <item name="welcomeMessage" xsi:type="string">Bleep Bloop!</item>
                                </item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>