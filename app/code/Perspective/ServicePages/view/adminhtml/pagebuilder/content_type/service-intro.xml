<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_PageBuilder:etc/content_type.xsd">
    <type name="service-intro"
          label="Intro"
          component="Magento_PageBuilder/js/content-type"
          preview_component="Magento_PageBuilder/js/content-type/html/preview"
          form="pagebuilder_service_intro_form"
          menu_section="single-service"
          icon="icon-pagebuilder-code"
          sortOrder="10"
          translate="label">
        <parents default_policy="deny">
            <parent name="root-container" policy="allow"/>
            <parent name="row" policy="allow"/>
            <parent name="column" policy="allow"/>
            <parent name="tab-item" policy="allow"/>
        </parents>
        <children default_policy="deny"/>
        <appearances>
            <appearance default="true"
                        name="default"
                        preview_template="Perspective_ServicePages/content-type/service-intro/default/preview"
                        master_template="Perspective_ServicePages/content-type/service-intro/default/master"
                        reader="Magento_PageBuilder/js/master-format/read/configurable">
                <elements>
                    <element name="main">
                        <html name="html" converter="Magento_PageBuilder/js/converter/html/decode"/>
                        <css name="css_classes"/>
                        <attribute name="name" source="data-content-type"/>
                        <attribute name="appearance" source="data-appearance"/>
                        <attribute name="title" source="title"/>
                        <attribute name="btn-text" source="btn-text"/>
                        <attribute name="description-one" source="description-one"/>
                        <attribute name="description-two" source="description-two"/>
                        <attribute name="description-tree" source="description"/>
                        <attribute name="image" source="src" converter="Magento_PageBuilder/js/converter/attribute/src"
                                   preview_converter="Magento_PageBuilder/js/converter/attribute/preview/src"/>
                        <attribute name="image_alt" source="image_alt" />
                    </element>
                </elements>
            </appearance>
        </appearances>
    </type>
</config>
